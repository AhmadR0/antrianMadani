# Alamat backend, dibaca saat BUILD (bukan saat runtime).
#
#   VITE_API_URL=/                       -> produksi: backend di origin yang sama (nginx mem-proxy
#                                           /antrian, /info, /foto, /suara-nama, /health ke backend)
#   VITE_API_URL=http://10.30.3.90:8000  -> backend di host/port lain
#   VITE_API_URL=                        -> dev: ditebak dari host halaman yang dibuka, port 8000
VITE_API_URL=
