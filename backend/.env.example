# Backend antrianMadani — contoh konfigurasi PRODUKSI.
# Salin menjadi .env (atau isi lewat environment Docker) dan sesuaikan nilainya.
# .env TIDAK boleh ikut commit (sudah ada di .gitignore).

# ---------- Server ----------
# production: endpoint simulasi (menulis ke antripoli) dimatikan. Dev: development.
NODE_ENV=production
PORT=8000
# Zona waktu proses. WAJIB di Docker (default kontainer = UTC) supaya "hari ini" dan jam praktik benar.
TZ=Asia/Makassar

# ---------- Database SIMRS Khanza (hanya dibaca, kecuali UPDATE status antripoli) ----------
# Gunakan akun MySQL khusus dengan hak minimal:
#   SELECT pada antripoli, reg_periksa, pasien, poliklinik, dokter, jadwal, pegawai, spesialis, kamar, bangsal
#   UPDATE pada antripoli (poller menandai baris yang sudah diumumkan: status '1' -> '0')
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sik
DB_USER=antrian
DB_PASSWORD=ganti-dengan-password-kuat

# ---------- Poller antripoli ----------
# Jeda pembacaan antripoli (ms). 1500 cukup responsif tanpa membebani database.
ANTRIAN_POLL_MS=1500
# true: hanya pasien yang terdaftar HARI INI yang dibunyikan; baris lama ditandai selesai tanpa suara.
# Di produksi harus true. Di dev boleh false supaya data dump lama bisa dipakai uji.
ANTRIAN_HANYA_HARI_INI=true
# Poli yang nama pasiennya disamarkan (tidak ditampilkan/disebut; dipanggil dengan nomor urut).
# SEMENTARA di sini dan harus sama dengan frontend/src/config/poli.ts; pindah ke tabel pengaturan di Langkah B.
POLI_SAMARKAN_NAMA=U0008,U0009,U0014

# ---------- Berkas ----------
# Folder foto pegawai Khanza (webapps/penggajian/pages/pegawai/photo), disajikan read-only di /foto.
# Di Docker: mount folder ini sebagai volume read-only.
FOTO_PEGAWAI_DIR=/var/www/khanza/webapps/penggajian/pages/pegawai/photo
# Cache MP3 kalimat panggilan buatan server, disajikan di /suara-nama. Di Docker: volume supaya tidak hilang.
SUARA_CACHE_DIR=/var/lib/antrian/cache/suara

# ---------- Suara panggilan dari server (Google Translate TTS, butuh internet di server) ----------
# false: tidak membuat MP3; TV memakai TTS browser (kalau ada) atau hanya bel.
SUARA_SERVER=true
# Batas tunggu ke Google per kalimat (ms). Lewat batas -> panggilan dikirim tanpa MP3.
SUARA_BATAS_MS=3000
# MP3 yang tidak dipakai lebih dari sekian hari dihapus otomatis.
SUARA_UMUR_CACHE_HARI=30
