# Variabel untuk docker-compose.yml. Salin menjadi .env di folder ini (root repo).
# Kredensial database TIDAK di sini, melainkan di backend/.env (lihat backend/.env.example).

# Port yang dibuka di server untuk TV (frontend + proxy API).
PORT_APLIKASI=8087

# Zona waktu semua kontainer.
TZ=Asia/Makassar

# Alamat MySQL Khanza dilihat dari dalam kontainer.
# host.docker.internal = mesin host ini. Kalau MySQL di server lain, isi IP-nya.
DB_HOST=host.docker.internal

# Folder foto pegawai Khanza DI HOST (webapps/penggajian/pages/pegawai/photo), dipasang read-only.
FOTO_PEGAWAI_HOST=/var/www/khanza/webapps/penggajian/pages/pegawai/photo
